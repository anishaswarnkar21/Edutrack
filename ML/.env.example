HOST=0.0.0.0
PORT=8000

# No auth between backend and ML service - both run on localhost only.

# Base model source used until a fine-tuned checkpoint exists.
# Use a local checkpoint path or a Hugging Face repo ID.
BASE_MODEL_NAME=anishaswarna23/edutrack-eg-large

# Directory the fine-tuned checkpoint is saved to by app/training/train.py.
# If it exists (and contains model weights), it is loaded before BASE_MODEL_NAME.
FINE_TUNED_MODEL_DIR=checkpoints/quiz-generator

# cpu | cuda | auto (auto picks cuda if available)
DEVICE=auto

MAX_INPUT_TOKENS=480
MAX_NEW_TOKENS=512
DEFAULT_NUM_QUESTIONS=16
