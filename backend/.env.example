NODE_ENV=development
PORT=5000

MONGO_URI=mongodb://127.0.0.1:26991/edutrack

JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=7d

CORS_ORIGIN=http://localhost:5173

UPLOAD_DIR=uploads
MAX_UPLOAD_MB=15

# Point at ML/ (port 8000) for real question-style MCQs from google/flan-t5-base, a
# medium (~250M param) model - this is the default. Switch to http://localhost:8001
# for ML-local/ (instant, zero-setup, but lower quality synthetic fill-in-the-blank
# mode unless you also enable its own real-model path).
ML_SERVICE_URL=http://localhost:8000
# flan-t5-base on CPU with beam search is much slower than a synthetic generator;
# generation runs in the background after upload, so a generous timeout just avoids
# a false "failed" status while it's still legitimately working.
ML_REQUEST_TIMEOUT_MS=180000

QUIZ_QUESTION_COUNT=5

# Used only by scripts/seedAdmin.js (npm run seed:admin) to create the one admin
# account - change the password after first login.
ADMIN_NAME=Admin
ADMIN_EMAIL=admin@edutrack.local
ADMIN_PASSWORD=ChangeMe123!
